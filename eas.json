{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      },
      "env": {
        "RCT_USE_RN_DEP": "1",
        "RCT_USE_PREBUILT_RNCORE": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "false"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "RCT_USE_RN_DEP": "1",
        "RCT_USE_PREBUILT_RNCORE": "1",
        "RCT_BUILD_HERMES_FROM_SOURCE": "false"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
